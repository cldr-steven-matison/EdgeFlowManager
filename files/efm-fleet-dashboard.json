{
  "uid": "efm-fleet",
  "title": "EFM Fleet - All Devices",
  "tags": ["efm", "edge", "fleet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "id": 10, "type": "row", "title": "Fleet — seconds since last heartbeat (EFM Layer 1)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "collapsed": false, "panels": []
    },
    {
      "id": 1, "type": "stat", "title": "MicroFi-1",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"MicroFi-1\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 600}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "MicroFi-2",
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"MicroFi-2\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 600}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "MicroFi-3",
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"MicroFi-3\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 600}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "NvidiaNano (Jetson)",
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"NvidiaNano\", agentId=\"2bcc2f9a-f584-4ac9-8c42-133b235a3201\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 600}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "stat", "title": "StarlinkAI (Beelink)",
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"StarlinkAI\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 600}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 6, "type": "stat", "title": "WindowsDesktop (agent)",
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"WindowsDesktop\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 600}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 7, "type": "timeseries", "title": "Heartbeats per minute by device",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "sum by (agentClass) (rate(efm_heartbeat_count_total{agentClass=~\"MicroFi-1|MicroFi-2|MicroFi-3|NvidiaNano|StarlinkAI|WindowsDesktop\"}[5m])) * 60", "legendFormat": "{{agentClass}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "opm", "custom": {"fillOpacity": 8}}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "Avg heartbeat size by device",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "sum by (agentClass) (rate(efm_heartbeat_contentLength_sum{agentClass=~\"MicroFi-1|MicroFi-2|MicroFi-3|NvidiaNano|StarlinkAI|WindowsDesktop\"}[5m])) / sum by (agentClass) (rate(efm_heartbeat_contentLength_count{agentClass=~\"MicroFi-1|MicroFi-2|MicroFi-3|NvidiaNano|StarlinkAI|WindowsDesktop\"}[5m]))", "legendFormat": "{{agentClass}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 8}}, "overrides": []}
    },
    {
      "id": 11, "type": "row", "title": "NvidiaNano host (flow-level exporter, Layer 2)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}, "collapsed": false, "panels": []
    },
    {
      "id": 9, "type": "stat", "title": "Jetson Scrape",
      "gridPos": {"h": 8, "w": 4, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "up{job=\"nvidianano-minifi-metrics\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 12, "type": "timeseries", "title": "Jetson load",
      "gridPos": {"h": 8, "w": 10, "x": 4, "y": 16},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "minifi_java_host_load1{job=\"nvidianano-minifi-metrics\"}", "legendFormat": "load1", "refId": "A"},
        {"expr": "minifi_java_host_load5{job=\"nvidianano-minifi-metrics\"}", "legendFormat": "load5", "refId": "B"},
        {"expr": "minifi_java_host_load15{job=\"nvidianano-minifi-metrics\"}", "legendFormat": "load15", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 8}}, "overrides": []}
    },
    {
      "id": 13, "type": "timeseries", "title": "Jetson memory",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 16},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "minifi_java_host_mem_total_kb{job=\"nvidianano-minifi-metrics\"}", "legendFormat": "total", "refId": "A"},
        {"expr": "minifi_java_host_mem_available_kb{job=\"nvidianano-minifi-metrics\"}", "legendFormat": "available", "refId": "B"},
        {"expr": "minifi_java_host_mem_free_kb{job=\"nvidianano-minifi-metrics\"}", "legendFormat": "free", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "deckbytes", "custom": {"fillOpacity": 8}}, "overrides": []}
    }
  ]
}

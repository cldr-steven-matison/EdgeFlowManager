nifi.python.processor.dir=${MINIFI_HOME}/asset
nifi.python.virtualenv.directory=${MINIFI_HOME}/minifi-python-env
nifi.python.install.packages.automatically=true
nifi.c2.agent.class=WindowsDesktopCppPyTest
